# Copy to .env for local development (used by docker-compose).
# Get sandbox credentials from https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional: only needed to receive Plaid webhooks locally (e.g. via an ngrok URL).
# PLAID_WEBHOOK_URL=https://<your-tunnel>/api/webhook
